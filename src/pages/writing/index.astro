---
import BaseLayout from "../../layouts/BaseLayout.astro";
const posts = [
  {
    title: "Animals Don’t Plan by Enumerating the Future",
    tags: ["Essay", "Planning", "Neuroscience"],
    description: "A look at predictive maps, successor representations, replay, and why long-horizon planning may rely on compressed futures instead of brute-force search.",
    href: "/writing/predictive-planning"
  },
  {
    title: "Why Token Efficiency Still Matters",
    tags: ["AI Systems", "Inference", "Efficiency"],
    description: "A working argument for why efficient reasoning remains important even as inference compute becomes abundant.",
    href: "/writing/token-efficiency"
  },
  {
    title: "Precision on a Budget",
    tags: ["AI Systems", "Quantization", "Inference"],
    description: "A research hypothesis on activation-aware precision routing under a fast-memory budget.",
    href: "/writing/precision-on-a-budget"
  }
];
---
<BaseLayout title="Writing — AI Research">
  <section class="hero">
    <div class="kicker">Writing</div>
    <h1>Notes on AI, research, and building.</h1>
    <p class="lede">Long-form thinking on reasoning, post-training, agents, efficiency, safety, and the practice of AI research.</p>
  </section>
  {posts.map(post => (
    <div class="card" style="margin-bottom: 32px;">
      <div class="meta">{post.tags.join(" · ")}</div>
      <h2 style="margin-top:0;"><a href={post.href}>{post.title}</a></h2>
      <p>{post.description}</p>
    </div>
  ))}
</BaseLayout>