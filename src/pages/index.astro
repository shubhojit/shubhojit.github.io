---
import BaseLayout from "../layouts/BaseLayout.astro";
const writing = [
  {
    title: "Why Token Efficiency Still Matters",
    description: "A working argument for why efficient reasoning remains important even as inference compute becomes abundant.",
    date: "Draft",
    href: "/writing/token-efficiency"
  },
  {
    title: "Precision on a Budget",
    description: "A research hypothesis on activation-aware precision routing under a fast-memory budget.",
    date: "Research note",
    href: "/writing/precision-on-a-budget"
  },
  {
    title: "From Static Benchmarks to Agentic Simulation",
    description: "What changes when evaluation becomes interactive, long-horizon, and grounded in realistic task trajectories.",
    date: "Coming soon",
    href: "/writing"
  },
  {
    title: "What Production-Scale AI Teaches You About Research",
    description: "Lessons from building multimodal reasoning systems where training stability, data quality, latency, and scientific progress all collide.",
    date: "Coming soon",
    href: "/writing"
  }
];
---
<BaseLayout title="AI Research">
  <section class="hero">
    <div class="kicker">AI research · systems · reasoning</div>
    <h1>Hi, this is Shubhojit.</h1>
    <p class="lede">
      I write down the things that follow me home.
    </p>
    <p>AI, research, and the occasional rabbit hole.</p>
    <p>
      I am particularly interested in the questions that emerge when capable
      models have to reason, act, learn from interaction, and operate reliably
      at scale.
    </p>
    <div class="links">
      <a href="/research">Research →</a>
      <a href="/writing">Writing →</a>
    </div>
  </section>

  <section>
    <h2>Writing</h2>
    <div class="grid">
      {writing.map(({ title, description, date, href }) => (
        <div class="card">
          <div class="meta">{date}</div>
          <h3><a href={href}>{title}</a></h3>
          <p>{description}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Currently</h2>
    <p>
      Exploring fundamental questions around reasoning, learning, evaluation,
      and how increasingly capable AI systems can become more efficient,
      reliable, and accessible.
    </p>
  </section>
</BaseLayout>