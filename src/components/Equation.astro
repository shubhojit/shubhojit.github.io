---
import katex from "katex";

interface Props {
  expression: string;
  label: string;
}

const { expression, label } = Astro.props;
const rendered = katex.renderToString(expression, {
  displayMode: true,
  output: "htmlAndMathml",
  throwOnError: false,
});
---

<div class="equation" role="figure" aria-label={label}>
  <div class="equation-inner" set:html={rendered} />
</div>

<style>
  .equation {
    margin: 28px 0;
    overflow-x: auto;
    color: var(--accent);
    font-size: 1.08rem;
    text-align: center;
  }

  .equation-inner {
    min-width: max-content;
    padding: 4px 8px;
  }
</style>