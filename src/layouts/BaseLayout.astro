---
const { title = "AI Research", description = "AI research, multimodal reasoning, post-training, and agentic systems." } = Astro.props;
import "katex/dist/katex.min.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Shubhojit Mallick</a>
      <nav>
        <a href="/research">Research</a>
        <a href="/writing">Writing</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div>© {new Date().getFullYear()} Shubhojit Mallick</div>
    </footer>
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap');

:root {
  --bg: #fbfaf7;
  --text: #242424;
  --muted: #6e6a64;
  --line: #dedbd4;
  --accent: #8a3d2f;
  --max: 920px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Source Serif 4", Georgia, serif;
  line-height: 1.72;
  font-size: 17px;
}
.site-header {
  max-width: var(--max);
  margin: 0 auto;
  padding: 30px 24px 20px;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24px;
  font-family: "DM Sans", sans-serif;
}
.brand { color: var(--text); font-weight: 600; text-decoration: none; letter-spacing: -.02em; }
nav { display: flex; flex-wrap: wrap; gap: 18px; }
nav a, footer a { color: var(--muted); text-decoration: none; }
nav a:hover, footer a:hover, a:hover { color: var(--accent); }
main { max-width: var(--max); margin: 0 auto; padding: 48px 24px 96px; }
footer {
  max-width: var(--max);
  margin: 0 auto;
  border-top: 1px solid var(--line);
  padding: 24px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted);
  font: 14px/1.5 "DM Sans", sans-serif;
}
.footer-links { display: flex; gap: 16px; }
h1, h2, h3 { font-weight: 500; line-height: 1.2; letter-spacing: -.025em; }
h1 { font-size: clamp(42px, 7vw, 68px); margin: 0 0 24px; }
h2 { font-size: 30px; margin: 60px 0 20px; }
h3 { font-size: 21px; margin: 0 0 7px; }
p { margin: 0 0 18px; }
a { color: var(--accent); }
.hero { max-width: 780px; padding: 35px 0 30px; }
.kicker { color: var(--accent); font: 600 13px/1.4 "DM Sans", sans-serif; letter-spacing: .08em; text-transform: uppercase; }
.lede { font-size: 23px; line-height: 1.55; max-width: 720px; }
.links { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 28px; font: 500 14px/1.5 "DM Sans", sans-serif; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.card { border-top: 1px solid var(--line); padding-top: 18px; }
.card p { color: var(--muted); font-size: 16px; }
.meta { color: var(--muted); font: 13px/1.5 "DM Sans", sans-serif; margin-bottom: 8px; }
.tag {
  display: inline-block; border: 1px solid var(--line); border-radius: 999px;
  padding: 4px 9px; margin: 3px 5px 3px 0; color: var(--muted);
  font: 12px/1.2 "DM Sans", sans-serif;
}
ul { padding-left: 22px; }
article { max-width: 760px; }
article h1 { font-size: clamp(38px, 6vw, 58px); }
article h2 { margin-top: 45px; }
article blockquote {
  border-left: 2px solid var(--accent); margin: 28px 0; padding: 4px 0 4px 22px;
  color: var(--muted); font-style: italic;
}
article code { font-family: "SFMono-Regular", Consolas, monospace; font-size: .9em; }
article pre { overflow-x: auto; padding: 18px; background: #f0eee9; border-radius: 6px; }
table { border-collapse: collapse; width: 100%; margin: 24px 0; }
th, td { text-align: left; padding: 10px; border-bottom: 1px solid var(--line); }
@media (max-width: 650px) {
  .site-header { align-items: flex-start; flex-direction: column; }
  nav { gap: 12px; }
  main { padding-top: 25px; }
  .grid { grid-template-columns: 1fr; }
  footer { flex-direction: column; }
}
</style>